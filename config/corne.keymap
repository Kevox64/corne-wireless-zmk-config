#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    behaviors {
        HMR: HMR {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-on-release;
            hold-trigger-key-positions = <15 0 12 24 25 13 1 2 14 26 27 36 37 38 3 4 5 17 16 28 29 39 40 41>;
        };

        HML: HML {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <6 10 11 18 19 20 21 22 23 30 31 32 33 34 35 40 41 39 7 8 9 36 37 38>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  Q  |  W  |  E  |  R  |  T  |   |  Y  |  U   |  I  |  O  |  P  | BKSP |
            // | CTRL |  A  |  S  |  D  |  F  |  G  |   |  H  |  J   |  K  |  L  |  ;  |  '   |
            // | SHFT |  Z  |  X  |  C  |  V  |  B  |   |  N  |  M   |  ,  |  .  |  /  | ESC  |
            //                    | GUI | LWR | SPC |   | ENT | RSE  | ALT |

            display-name = "Base";
            bindings = <
&kp TAB     &kp Q              &kp W            &kp E            &kp R              &kp T          &kp Y        &kp U               &kp I             &kp O             &kp P                         &kp BACKSLASH
&kp ESCAPE  &HML LEFT_SHIFT A  &HML LEFT_ALT S  &HML LEFT_GUI D  &HML LEFT_SHIFT F  &kp G          &kp H        &HMR RIGHT_SHIFT J  &HMR RIGHT_GUI K  &HMR RIGHT_ALT L  &HMR RIGHT_CONTROL SEMICOLON  &kp SQT
&kp LSHFT   &kp Z              &kp X            &kp C            &kp V              &kp B          &kp N        &kp M               &kp COMMA         &kp DOT           &kp FSLH                      &kp RIGHT_SHIFT
                                                &lt 6 TAB        &lt 5 ESCAPE       &lt 7 SPACE    &lt 3 ENTER  &lt 4 BACKSPACE     &lt 6 DEL
            >;
        };

        lower_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  1  |  2  |  3  |  4  |  5  |   |  6  |  7  |  8  |  9  |  0  | BKSP |
            // | BTCLR| BT1 | BT2 | BT3 | BT4 | BT5 |   | LFT | DWN |  UP | RGT |     |      |
            // | SHFT |     |     |     |     |     |   |     |     |     |     |     |      |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Lower";
            bindings = <
&kp TAB     &kp N1        &kp N2        &kp N3        &kp N4        &kp N5          &kp N6    &kp N7    &kp N8    &kp N9     &kp N0  &kp BSPC
&bt BT_CLR  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &kp LEFT  &kp DOWN  &kp UP    &kp RIGHT  &trans  &trans
&kp LSHFT   &trans        &trans        &trans        &trans        &trans          &trans    &trans    &trans    &trans     &trans  &trans
                                        &kp LGUI      &trans        &kp SPACE       &kp RET   &trans    &kp RALT
            >;
        };

        raise_layer {
            // -----------------------------------------------------------------------------------------
            // |  TAB |  !  |  @  |  #  |  $  |  %  |   |  ^  |  &  |  *  |  (  |  )  | BKSP |
            // | CTRL |     |     |     |     |     |   |  -  |  =  |  [  |  ]  |  \  |  `   |
            // | SHFT |     |     |     |     |     |   |  _  |  +  |  {  |  }  | "|" |  ~   |
            //                    | GUI |     | SPC |   | ENT |     | ALT |

            display-name = "Raise";
            bindings = <
&kp TAB    &kp EXCL  &kp AT  &kp HASH  &kp DLLR  &kp PRCNT    &kp CARET  &kp AMPS   &kp KP_MULTIPLY  &kp LPAR  &kp RPAR  &kp BSPC
&kp LCTRL  &trans    &trans  &trans    &trans    &trans       &kp MINUS  &kp EQUAL  &kp LBKT         &kp RBKT  &kp BSLH  &kp GRAVE
&kp LSHFT  &trans    &trans  &trans    &trans    &trans       &kp UNDER  &kp PLUS   &kp LBRC         &kp RBRC  &kp PIPE  &kp TILDE
                             &kp LGUI  &trans    &kp SPACE    &kp RET    &trans     &kp RALT
            >;
        };

        layer_3 {
            bindings = <
&trans            &kp LEFT_BRACKET  &kp N7  &kp N8   &kp N9  &kp RIGHT_BRACKET    &trans  &trans     &trans    &trans    &trans     &trans
&kp LESS_THAN     &kp SEMI          &kp N4  &kp N5   &kp N6  &kp EQUAL            &trans  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &trans
&kp GREATER_THAN  &kp GRAVE         &kp N1  &kp N2   &kp N3  &kp BSLH             &trans  &trans     &trans    &trans    &trans     &trans
                                            &kp DOT  &kp N0  &kp MINUS            &trans  &trans     &trans
            >;
        };

        layer_4 {
            bindings = <
&trans            &kp LEFT_BRACE  &kp AMPERSAND  &kp STAR              &kp LEFT_PARENTHESIS   &kp RIGHT_BRACE    &trans  &trans     &trans    &trans    &trans     &trans
&kp LESS_THAN     &kp COLON       &kp DOLLAR     &kp PERCENT           &kp CARET              &kp PLUS           &trans  &kp RSHFT  &kp RGUI  &kp RALT  &kp RCTRL  &trans
&kp GREATER_THAN  &kp TILDE       &kp EXCL       &kp AT                &kp HASH               &kp PIPE           &trans  &trans     &trans    &trans    &trans     &trans
                                                 &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp UNDER          &trans  &trans     &trans
            >;
        };

        layer_5 {
            bindings = <
&trans  &trans     &trans    &trans    &trans     &trans    &kp K_PASTE     &kp K_COPY      &kp K_CUT     &kp PAGE_UP      &kp HOME  &kp PRINTSCREEN
&trans  &kp LCTRL  &kp LALT  &kp LGUI  &kp LSHFT  &trans    &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp DEL   &kp CAPSLOCK
&trans  &trans     &trans    &trans    &trans     &trans    &kp K_AGAIN     &kp K_UNDO      &kp C_PAUSE   &kp PAGE_DOWN    &kp END   &kp C_PAUSE
                             &trans    &trans     &trans    &trans          &trans          &trans
            >;
        };

        layer_6 {
            bindings = <
&trans  &kp HOME  &kp F7  &kp F8   &kp F9   &trans     &trans  &trans     &trans    &trans    &trans     &trans
&trans  &kp DEL   &kp F4  &kp F5   &kp F6   &trans     &trans  &kp LSHFT  &kp LGUI  &kp LALT  &kp LCTRL  &trans
&trans  &kp END   &kp F1  &kp F2   &kp F3   &trans     &trans  &trans     &trans    &trans    &trans     &trans
                          &kp F10  &kp F11  &kp F12    &trans  &trans     &trans
            >;
        };

        layer_7 {
            bindings = <
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans            &trans           &trans             &trans      &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &kp K_PREV        &kp C_VOLUME_UP  &kp C_VOLUME_DOWN  &kp K_NEXT  &trans
&trans  &trans  &trans  &trans  &trans  &trans    &trans      &trans            &trans           &trans             &trans      &trans
                        &trans  &trans  &trans    &kp K_STOP  &kp K_PLAY_PAUSE  &kp K_MUTE
            >;
        };
    };
};
